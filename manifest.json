{
  "manifest_version": 3,
  "name": "Goldfish",
  "version": "0.1.0",
  "description": "Tracks the water cost of your AI prompts.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*"
  ],
  "icons": {
    "16": "assets/fish/icon.PNG",
    "32": "assets/fish/icon.PNG",
    "48": "assets/fish/icon.PNG",
    "128": "assets/fish/icon.PNG"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["platform-claude.js", "content.js", "aquarium.js", "games.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["platform-chatgpt.js", "content.js", "aquarium.js", "games.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["platform-gemini.js", "content.js", "aquarium.js", "games.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/fish/icon.PNG",
      "32": "assets/fish/icon.PNG",
      "48": "assets/fish/icon.PNG",
      "128": "assets/fish/icon.PNG"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/fish/*", "assets/numbers/*", "assets/aquarium/*", "assets/usage/*"],
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ]
    }
  ]
}
