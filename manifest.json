{
  "manifest_version": 3,
  "name": "Goldfish",
  "version": "0.1.0",
  "description": "A mindful companion for your AI habit. Prompt less, think more.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://claude.ai/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js", "aquarium.js", "games.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html" },
  "web_accessible_resources": [
    {
      "resources": ["assets/fish/*", "assets/numbers/*", "assets/aquarium/*", "assets/usage/*"],
      "matches": ["https://claude.ai/*"]
    }
  ]
}
